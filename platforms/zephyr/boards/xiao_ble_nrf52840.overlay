// Seeed XIAO nRF52840 (Zephyr board xiao_ble). Board facts come from the upstream
// Zephyr board: uart0 is routed to the silkscreened TX/RX pads (D6 P1.11 / D7
// P1.12), there's a USB device controller (zephyr_udc0), and an onboard RGB user
// LED (led0 red P0.26, led1 green P0.30, led2 blue P0.06; active low), all of
// which the board already aliases. This overlay only adds OUR Duta wiring:
//   * CMD + DATA mux  -> a CDC ACM port on the USB device controller.
//   * DATA console     -> uart0 (the D6/D7 pads).
//   * Status LED       -> led0 (the RGB's red channel) — the only default output.
//     Relays / external fixtures are provisioned at runtime onto free pads via
//     Configure Device, not a fact about this board.

#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>

/ {
	aliases {
		duta-data = &uart0; // led0/led1/led2 are already aliased by the board
	};

	// Two internal ADC inputs (skrit inputs 0/1): ch0 = VDD ("Supply (mV)", the
	// regulated rail); ch1 = VDDHDIV5 ("Battery (mV)", VDDH/5 ×5 in fw — the cell
	// on this nice!nano-class board, but reads high on USB). No pin needed.
	zephyr,user {
		io-channels = <&adc 0>, <&adc 1>;
	};
};

// The CDC ACM that carries the mux link (main.c looks for cdc_acm_uart0).
&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
};

&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_VDD>;
		zephyr,resolution = <12>;
	};
	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_VDDHDIV5>; // battery via VDDH/5 (×5 in fw)
		zephyr,resolution = <12>;
	};
};
