// nRF52840 Dongle — Duta transport map. The dongle has no debug UART, so DATA
// uses UART1 on two exposed castellated pads (P1.10 TX / P1.13 RX — adjust to
// your wiring). CMD + DATA still mux over a CDC ACM port. Outputs reuse the
// on-board LEDs (green led0 + two of the RGB channels).
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
	aliases {
		duta-data = &uart1;
	};
};

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
	};
};

&pinctrl {
	uart1_default: uart1_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 10)>,
			        <NRF_PSEL(UART_RX, 1, 13)>;
		};
	};

	uart1_sleep: uart1_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 10)>,
			        <NRF_PSEL(UART_RX, 1, 13)>;
			low-power-enable;
		};
	};
};

&uart1 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart1_default>;
	pinctrl-1 = <&uart1_sleep>;
	pinctrl-names = "default", "sleep";
};
