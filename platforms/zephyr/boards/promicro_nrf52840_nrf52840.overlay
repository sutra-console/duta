// Pro Micro nRF52840 — the "nice!nano v2 compatible" / SuperMini clone family.
// Board facts come from the upstream Zephyr board (boards/others/promicro_nrf52840):
//   * led0 = P0.15 (onboard blue LED), uart0 routed to the silkscreened TX/RX
//     pads (P0.09 TX / P0.10 RX; the NFC pins, freed as GPIO by the board UICR),
//     and a USB CDC ACM (cdc_acm_uart0) already in the board DTS.
// This overlay only adds OUR Duta wiring:
//   * CMD + DATA mux   -> the board's USB CDC ACM (BLE alt via overlay-ble.conf).
//   * DATA console      -> uart0 (TX P0.09 / RX P0.10).
//   * Status LED        -> led0 (the onboard blue LED) — the only default output.
//   External fixtures (relays, etc.) are NOT a compiled default: add them at
//   runtime via provisioning on the free broken-out pads.

#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>

/ {
	aliases {
		duta-data = &uart0; // led0 (status LED) is already aliased by the board
	};

	// Two ADC inputs (skrit inputs 0 and 1), both internal — no broken-out pin:
	//   ch 0 = NRF_SAADC_VDD     → "Supply (mV)": the regulated rail (~3.0–3.3 V).
	//   ch 1 = NRF_SAADC_VDDHDIV5 → "Battery (mV)": VDDH/5; main.c ×5. On this
	//     nice!nano-clone family VDDH is fed from the LiPo (HV mode), so this reads
	//     the cell — but it tracks VDDH, so it reads HIGH on USB (~charge voltage),
	//     not the battery. The board's labelled P0.04 battery divider is mis-wired
	//     to P0.24 (no SAADC channel) upstream, so VDDHDIV5 is the usable path.
	// For an external analog pad instead, point a channel at <NRF_SAADC_AINx>
	// (AIN0 = P0.02, AIN2 = P0.04) and drop the ×5 in main.c for that index.
	zephyr,user {
		io-channels = <&adc 0>, <&adc 1>;
	};
};

&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_VDD>;
		zephyr,resolution = <12>;
	};
	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_VDDHDIV5>; // battery via VDDH/5 (×5 in fw)
		zephyr,resolution = <12>;
	};
};
